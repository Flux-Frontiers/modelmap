<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>modelmap</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>15.0</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSDesktopFolderUsageDescription</key>
	<string>modelmap looks for model files on your Desktop so it can show how much space they take.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>modelmap looks for model files in Documents so it can show how much space they take.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>modelmap looks for downloaded model files in Downloads so it can show how much space they take.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright 2026 Eric G. Suchanek, PhD. BSD-3-Clause.</string>
	<key>NSNetworkVolumesUsageDescription</key>
	<string>modelmap scans the network drives you choose for model files.</string>
	<key>NSRemovableVolumesUsageDescription</key>
	<string>modelmap scans the drives you choose for model files.</string>
</dict>
</plist>
